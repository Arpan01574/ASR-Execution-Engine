# ASR Engine v3 - Environment Configuration
# COPY THIS FILE TO .env AND FILL IN THE VALUES

# ----------------------------------------------------
# SYSTEM MODE
# ----------------------------------------------------
# PAPER, DEMO, or LIVE. LIVE is disabled by default.
TRADING_MODE=PAPER

# Security
# Random token for the TradingView webhook URL: /webhook/tradingview/{token}
WEBHOOK_URL_TOKEN=your_secure_random_url_token_here
# Passphrase that TradingView must send inside the JSON payload
WEBHOOK_PASSPHRASE=your_secure_payload_passphrase_here

# ----------------------------------------------------
# BINANCE (Primary Adapter)
# ----------------------------------------------------
# Use Testnet keys for PAPER and DEMO mode
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Optional: Set to true if using Testnet
BINANCE_USE_TESTNET=true

# ----------------------------------------------------
# DATABASE
# ----------------------------------------------------
# Local SQLite database path
DATABASE_URL=sqlite:///./asr_engine.db

# ----------------------------------------------------
# RISK & NOTIFICATIONS
# ----------------------------------------------------
MAX_GLOBAL_DRAWDOWN_PCT=20.0
# Optional Telegram for heartbeat and critical alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
