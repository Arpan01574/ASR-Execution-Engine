# ASR Engine v3 - Root Environment Configuration
# Symlink to execution/.env for unified access

# SYSTEM MODE
TRADING_MODE=DEMO

# BINANCE DEMO CREDENTIALS
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_USE_TESTNET=true

# WEBHOOK SECURITY
WEBHOOK_URL_TOKEN=your_webhook_url_token_here
WEBHOOK_PASSPHRASE=your_webhook_passphrase_here

# DATABASE
DATABASE_URL=sqlite:///./execution/data/asr_demo_trading.db

# RISK
RISK_PER_TRADE_PCT=0.5
MAX_GLOBAL_DRAWDOWN_PCT=15.0
MAX_SLIPPAGE_PCT=0.3

# TELEGRAM NOTIFICATIONS
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
